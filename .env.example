# Copy to .env and fill in. Only these values change between the laptop and the VM.

# Laptop: free Grok API
LLM_BASE_URL=https://api.x.ai/v1
LLM_MODEL=grok-3-mini
LLM_API_KEY=<your xAI key>

# VM: local Qwen3 Coder (OpenAI-compatible server); the key can stay empty
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL=<model name reported by the local server>
# LLM_API_KEY=

LLM_CONTEXT_TOKENS=64000
LLM_MAX_OUTPUT_TOKENS=8000
